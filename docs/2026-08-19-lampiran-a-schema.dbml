// =============================================================
// Schema dari Lampiran A: Deskripsi Field per Tabel
// docs/2026-08-19-rename-tabel-laravel-design.md
//
// Konvensi:
//  - id uuid [pk]  -> PK Laravel (mengikuti pola kode, Lampiran B #1)
//  - [unique]      -> business key unik (BK)
//  - [ref: > x]    -> many-to-one  (banyak baris tabel ini -> 1 x)
//  - [ref: - x]    -> one-to-one
//  - [ref: <> x]   -> many-to-many (pivot)
//  - target FK memakai business key (join eksisting), bukan kolom id.
// =============================================================

// ---------- Master / Kanonik ----------

Table users {
  id uuid [pk]
  kode_user varchar [unique]
  name varchar
  email varchar [unique]
  note: 'users Laravel (kanonik)'
}

Table okas {
  oka varchar [pk, note: 'PK/BK unik']
  kode_proyek varchar [ref: > proyeks.kode_proyek]
  wbs varchar
  ket text
  total_car varchar
  total_lot bigint
  jig varchar
  prototype varchar
  bogie varchar
  ktidur varchar
  total_lot1 bigint
  total_lot2 bigint
  total_lot3 bigint
  total_lot4 bigint
  tgl_oka date
  label_proyek varchar
  ket_proyek text
  tampil_g boolean
  note: 'master unit/order kereta'
}

Table proyeks {
  kode_proyek varchar [pk, note: 'PK/BK unik']
  nama varchar
  aktif varchar
  note: 'master proyek'
}

Table processes {
  id uuid [pk]
  id_proses varchar [note: 'BK']
  kode_proses varchar [unique]
  nama varchar
  id_kel varchar
  note: 'master proses (proses)'
}

Table mesins {
  id uuid [pk]
  id_mesin varchar [note: 'BK']
  kode_mesin varchar [unique]
  nama varchar
  id_proses varchar [ref: > processes.id_proses]
  note: 'master mesin'
}

Table jenis_keretas {
  id uuid [pk]
  jenis_kereta varchar [unique]
  ket_jenis varchar
  note: 'master jenis kereta (jenis_kereta_tb)'
}

Table wi_trn_bpms {
  id uuid [pk]
  id_wi_trn_bpm varchar [note: 'BK']
  idbarang varchar [unique, note: 'PK/BK unik']
  spec varchar
  ket varchar
  user varchar [ref: > users.kode_user]
  note: 'master material WI (kode material + spesifikasi)'
}

Table drawings {
  id uuid [pk]
  proyek varchar [ref: > proyeks.kode_proyek]
  nogbr varchar [unique]
  nama varchar
  tgl date
  rev varchar
  detail bigint
  jml_md bigint
  jml_wi bigint
  note: 'gambar drawing'
}

Table md_headers {
  id uuid [pk]
  id_md varchar [unique]
  part_no varchar [unique]
  partno1 varchar
  maspart varchar
  nogbr varchar [ref: > drawings.nogbr]
  nopost varchar
  title varchar
  material varchar [ref: > wi_trn_bpms.idbarang]
  type varchar
  t1 decimal
  h1 decimal
  b1 decimal
  l1 decimal
  nama_group varchar
  qa_tc1 decimal
  qb_mc1 varchar
  sh1 varchar
  sh2 varchar
  sh3 varchar
  ws1 varchar
  ws2 varchar
  ws3 varchar
  ws4 varchar
  ws5 varchar
  ws6 varchar
  ws7 varchar
  ws8 varchar
  des text
  tgl date
  rev varchar
  mdh_md2 varchar [unique]
  note: 'header Manufacture Drawing (MD)'
}

Table md2s {
  id uuid [pk]
  md2_mdh varchar [unique]
  md2_jadwal varchar
  konv_md varchar
  note: 'referensi md2 (tabel target jadwals/md_headers)'
}

Table md_laps {
  id uuid [pk]
  no_part1 varchar
  oka1 varchar
  lot1 varchar
  note: 'laporan MD (tabel target, dari kode legacy)'
}

Table sttpp_details {
  id uuid [pk]
  nosttpp varchar [unique]
  note: 'detail STTP (tabel target, dari kode legacy)'
}

// ---------- Audit & Notifikasi ----------

Table audit_logs {
  id uuid [pk]
  table_name varchar
  record_id varchar
  action varchar
  old_value text
  new_value text
  changed_fields text
  user_id uuid [ref: > users.id]
  user_name varchar
  ip_address varchar
  created_at datetime
  note: 'log aktivitas pengguna (audit_log)'
}

Table notifications {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  message text
  is_read bigint
  created_at datetime
  related_table varchar
  related_id varchar
  note: 'notifikasi'
}

// ---------- Barcode ----------

Table barcodes {
  id uuid [pk]
  oka varchar [ref: > okas.oka]
  wbs varchar
  lot varchar
  part_no varchar [note: 'BK komposit dgn PR']
  partno1 varchar
  PR varchar [ref: > wi_trns.no_ctplan]
  no_konv varchar [unique, ref: - wi_trns.no_konv]
  tgl date
  status varchar
  bil varchar
  user_barcode varchar [ref: > users.kode_user]
  tgl_print date
  note: 'data barcode per part/oka/lot'
}

Table barcode_details {
  id uuid [pk]
  no_konv varchar [ref: > barcodes.no_konv]
  proses varchar [ref: > processes.kode_proses]
  tgl datetime
  qty bigint
  jml_org bigint
  user_brcode varchar [ref: > users.kode_user]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  note: 'riwayat scan/proses barcode (barcode_detail)'
}

Table barcode_starts {
  id uuid [pk]
  no_konv varchar [ref: > barcodes.no_konv]
  proses varchar [ref: > processes.kode_proses]
  tgl_start datetime
  user_brcode varchar [ref: > users.kode_user]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  note: 'awal proses barcode (barcode_start)'
}

// ---------- BPM ----------

Table bpms {
  id uuid [pk]
  no_bpm varchar [unique]
  oka varchar [ref: > okas.oka]
  kode_mat varchar [ref: > wi_trn_bpms.idbarang]
  spec varchar
  jumlah bigint
  satuan varchar
  tgl_permintaan date
  ket_bpm varchar
  no_konv_bpm varchar [ref: > wi_trns.no_konv]
  no_bprm varchar
  tgl_bprm date
  head_number varchar
  jml_bprm varchar
  stok varchar
  user varchar [ref: > users.kode_user]
  note: 'Bahan Permintaan Material (BPM)'
}

Table bpm_ims {
  id uuid [pk]
  no_bpm varchar [unique]
  oka varchar [ref: > okas.oka]
  kode_mat varchar [ref: > wi_trn_bpms.idbarang]
  spec varchar
  jumlah bigint
  satuan varchar
  tgl_permintaan date
  ket_bpm varchar
  no_konv_bpm varchar [ref: > wi_trns.no_konv]
  no_bprm varchar
  tgl_bprm date
  head_number varchar
  jml_bprm varchar
  stok varchar
  penerbit_bpm varchar
  user_bpm_ims varchar [ref: > users.kode_user]
  note: 'BPM unit IMS'
}

Table ims_bpms {
  id uuid [pk]
  no_bpm varchar [unique]
  oka varchar [ref: > okas.oka]
  kode_mat varchar [ref: > wi_trn_bpms.idbarang]
  spec varchar
  jumlah bigint
  satuan varchar
  tgl_permintaan date
  ket_bpm varchar
  no_konv_bpm varchar [ref: > wi_trns.no_konv]
  no_bprm varchar
  tgl_bprm date
  head_number varchar
  jml_bprm varchar
  stok varchar
  penerbit_bpm varchar
  user_bpm_ims varchar [ref: > users.kode_user]
  note: 'BPM IMS (duplikat/arsip bpm_ims)'
}

Table memo_proses_masuks {
  id uuid [pk]
  no_proses_masuk varchar [unique]
  kode_mat_memo varchar [ref: > wi_trn_bpms.idbarang]
  spec_mat_memo varchar
  qty varchar
  satuan varchar
  no_memo_spp varchar [ref: > spms.no_spm]
  kode_mat_spp varchar
  spec_mat_spp varchar
  qty_spp varchar
  no_memo_bpm varchar [ref: > bpms.no_bpm]
  kode_mat_bpm varchar
  spec_mat_bpm varchar
  qty_bpm varchar
  tgl_memo_bpm date
  user_proses_masuk varchar [ref: > users.kode_user]
  note: 'memo proses masuk (memo_proses_masuk)'
}

// ---------- SPM ----------

Table spms {
  id uuid [pk]
  no_bpm varchar [ref: > bpms.no_bpm]
  oka varchar [ref: > okas.oka]
  kode_mat varchar [ref: > wi_trn_bpms.idbarang]
  spec varchar
  jml_bpm bigint
  satuan varchar
  no_cp varchar [ref: > cp_details.cp_no]
  no_spm varchar [unique]
  jml_spm bigint
  tgl_spm date
  ket_spm varchar
  no_konv_spm varchar [ref: > wi_trns.no_konv]
  user_spm varchar [ref: > users.kode_user]
  note: 'Surat Permintaan Material (SPM)'
}

Table spm_ims {
  id uuid [pk]
  no_bpm varchar [ref: > bpms.no_bpm]
  oka varchar [ref: > okas.oka]
  kode_mat varchar [ref: > wi_trn_bpms.idbarang]
  spec varchar
  jml_bpm bigint
  satuan varchar
  no_cp varchar [ref: > cp_details.cp_no]
  no_spm varchar [unique]
  jml_spm bigint
  tgl_spm date
  ket_spm varchar
  no_konv_spm varchar [ref: > wi_trns.no_konv]
  head_numbr varchar
  penerbit_bpm varchar
  user_spm_ims varchar [ref: > users.kode_user]
  note: 'SPM unit IMS'
}

Table ims_spms {
  id uuid [pk]
  no_bpm varchar [ref: > bpms.no_bpm]
  oka varchar [ref: > okas.oka]
  kode_mat varchar [ref: > wi_trn_bpms.idbarang]
  spec varchar
  jml_bpm varchar
  satuan varchar
  no_spm varchar [unique]
  jml_spm varchar
  tgl_spm date
  ket_spm varchar
  no_konv_spm varchar [ref: > wi_trns.no_konv]
  no_konv_bpm varchar [ref: > wi_trns.no_konv]
  user_spm_ims varchar [ref: > users.kode_user]
  note: 'SPM IMS (ims_spm)'
}

Table spm_orgs {
  id uuid [pk]
  id_spm_org varchar [note: 'BK']
  no_spm_org varchar [ref: - spms.no_spm]
  diminta varchar [ref: > users.kode_user]
  mengetahui varchar [ref: > users.kode_user]
  diterima varchar [ref: > users.kode_user]
  tgl_spm_org date
  note: 'tanda tangan organisasi SPM (spm_org)'
}

Table spm_ims_orgs {
  id uuid [pk]
  id_spm_ims_org varchar [note: 'BK']
  no_spm_ims_org varchar [ref: - spm_ims.no_spm]
  diminta varchar [ref: > users.kode_user]
  mengetahui varchar [ref: > users.kode_user]
  diterima varchar [ref: > users.kode_user]
  tgl_spm_ims_org date
  note: 'tanda tangan SPM IMS (spm_ims_org)'
}

Table spm_ppcbs {
  id uuid [pk]
  id_spm_ppcb varchar [note: 'BK']
  no_spm_ppcb varchar [unique]
  no_cp_ppcb varchar [ref: > cp_details.cp_no]
  no_bpm_ppcb varchar [ref: > bpms.no_bpm]
  komat_ppcb varchar [ref: > wi_trn_bpms.idbarang]
  qty_bpm_ppcb varchar
  oka_ppcb varchar [ref: > okas.oka]
  proyek_ppcb varchar [ref: > proyeks.kode_proyek]
  lot_ppcb varchar
  qty_spm_ppcb varchar
  pengirim_spm_ppcb varchar [ref: > users.kode_user]
  mengetahui_spm_ppcb varchar [ref: > users.kode_user]
  penerima_spm_ppcb varchar [ref: > users.kode_user]
  tgl_spm date
  ket_spm_ppcb varchar
  note: 'SPM PPCB (spm_ppcb)'
}

// ---------- Cutting Plan ----------

Table cp_details {
  id uuid [pk]
  id_cp varchar [note: 'BK']
  no_exp varchar [ref: > exps.no_exp]
  part_no varchar [ref: > md_headers.part_no]
  rev_cp varchar
  cp_no varchar [unique]
  oka varchar [ref: > okas.oka]
  lot varchar
  qty_lot varchar
  mat_cp varchar [ref: > wi_trn_bpms.idbarang]
  spek_mat_cp varchar
  group varchar
  qty varchar
  shop_name varchar
  mat_sisa varchar
  tgl_cp date
  planer varchar [ref: > users.kode_user]
  nama_komp varchar
  note: 'Cutting Plan aktif (cp_1)'
}

Table cps {
  id uuid [pk]
  id_cp varchar [note: 'BK']
  no_cp varchar [unique]
  oka varchar [ref: > okas.oka]
  part_no varchar [ref: > md_headers.part_no]
  mat varchar
  spec_mat varchar
  qty varchar
  mat_sisa varchar
  no_exp varchar [ref: > exps.no_exp]
  shop varchar
  pic_cp varchar [ref: > users.kode_user]
  diterima varchar
  tgl_kirim date
  grup varchar
  lot varchar
  qty_lot varchar
  note: 'Cutting Plan (cp)'
}

Table ct_plants {
  id uuid [pk]
  oka varchar [ref: > okas.oka]
  kode_proyek varchar [ref: > proyeks.kode_proyek]
  lot varchar
  no_ctplan varchar [ref: > cp_details.cp_no]
  bpm_no varchar [ref: > bpms.no_bpm]
  idbarang varchar [ref: > wi_trn_bpms.idbarang]
  tgl date
  detail bigint
  status varchar
  jenis_kereta varchar [ref: > jenis_keretas.jenis_kereta]
  note: 'jadwal cutting plan (ct_plant)'
}

Table bpm_cps {
  id uuid [pk]
  no_bpm varchar [ref: <> bpms.no_bpm]
  no_cp varchar [ref: <> cp_details.cp_no]
  kode_mat varchar [ref: > wi_trn_bpms.idbarang]
  spec varchar
  jumlah_bpm varchar
  ket_mat varchar
  oka_bpm varchar [ref: > okas.oka]
  tgl_bpm date
  ket_bpm varchar
  user_bpm_cp varchar [ref: > users.kode_user]
  mat_cp varchar
  spek_mat_cp varchar
  qty_cp varchar
  mat_sisa varchar
  status_mat varchar
  no_pr varchar
  no_po varchar
  eta varchar
  note: 'pivot BPM <-> Cutting Plan (bpm_cp)'
}

// ---------- Ekspedisi ----------

Table exps {
  id uuid [pk]
  no_exp varchar [unique]
  no_cp varchar [ref: > cp_details.cp_no]
  no_part varchar [ref: > md_headers.part_no]
  oka varchar [ref: > okas.oka]
  lot varchar
  tgl_kirim date
  tgl_kembali date
  pengirim varchar [ref: > users.kode_user]
  penerima varchar [ref: > users.kode_user]
  tujuan varchar
  ket_exp varchar
  note: 'ekspedisi dokumen (exp)'
}

Table exp_cps {
  id uuid [pk]
  id_exp_cp bigint [note: 'BK']
  exp_cp varchar [unique]
  cp varchar [ref: <> cp_details.cp_no]
  nama_komp varchar
  oka varchar [ref: > okas.oka]
  destinasi varchar
  tgl_kirim date
  pengirim varchar [ref: > users.kode_user]
  penerima varchar [ref: > users.kode_user]
  tgl_terima date
  note: 'pivot CP <-> ekspedisi (exp_cp)'
}

Table exp_orgs {
  id uuid [pk]
  no_exp varchar [ref: > exps.no_exp]
  nama_kirim varchar
  tgl_kirim date
  note: 'ekspedisi organisasi/asal (exp_org)'
}

Table pipts {
  id uuid [pk]
  no_doc varchar [unique]
  nama_doc varchar
  oka varchar [ref: > okas.oka]
  wbs varchar
  jenis_doc varchar
  tgl_terima date
  tgl_kirim date
  revisi varchar
  bag_penerima varchar
  no_exp varchar [ref: > exps.no_exp]
  note: 'dokumen PIPT (pipt)'
}

// ---------- STTP ----------

Table sttpps {
  id uuid [pk]
  nosttpp varchar [unique]
  oka varchar [ref: > okas.oka]
  proyek varchar [ref: > proyeks.kode_proyek]
  kontrak varchar
  lppb varchar
  tgl_lppb date
  tgl_krm date
  dari varchar
  ke varchar
  pengirim varchar [ref: > users.kode_user]
  penerima varchar [ref: > users.kode_user]
  detail bigint
  tahun varchar
  note: 'header STTP (sttpp)'
}

Table sttpp_fabs {
  id uuid [pk]
  id_sttp_fab varchar [note: 'BK']
  no_sttp varchar [ref: > sttpps.nosttpp]
  no_part varchar [ref: > md_headers.part_no]
  name_part varchar
  oka varchar [ref: > okas.oka]
  proyek varchar [ref: > proyeks.kode_proyek]
  lot varchar
  qty_lot varchar
  qty_kirim varchar
  satuan varchar
  tgl_kirim date
  dari varchar
  ke varchar
  pengirim varchar [ref: > users.kode_user]
  penerima varchar [ref: > users.kode_user]
  keterangan varchar
  jenis_kereta varchar [ref: > jenis_keretas.jenis_kereta]
  user_sttp varchar [ref: > users.kode_user]
  tgl_input date
  rev varchar
  note: 'detail STTP fabrikasi (sttpp_fab)'
}

Table sttp_dalmats {
  id uuid [pk]
  id_sttp_dalmat bigint [note: 'BK']
  no_sjn varchar [unique]
  no_sttp varchar [unique]
  no_part varchar [ref: > md_headers.part_no]
  nama_part varchar
  oka varchar [ref: > okas.oka]
  proyek varchar [ref: > proyeks.kode_proyek]
  lot varchar
  qty_kirim varchar
  tgl_kirim date
  satuan varchar
  keterangan varchar
  note: 'STTP kirim dalmat (sttp_dalmat)'
}

Table sttp_dalmat_datangs {
  id uuid [pk]
  id_sttp_dalmat_datang varchar [note: 'BK']
  no_sjn varchar [unique]
  no_sttp varchar [unique]
  no_part varchar [ref: > md_headers.part_no]
  nama_part varchar
  oka varchar [ref: > okas.oka]
  proyek varchar [ref: > proyeks.kode_proyek]
  lot varchar
  qty_kirim varchar
  tgl_kirim date
  satuan varchar
  keterangan varchar
  qty_datang varchar
  tgl_datang date
  note: 'STTP datang dalmat (sttp_dalmat_datang)'
}

Table sttp_dalmat_datang_orgs {
  id uuid [pk]
  id_sttp_org varchar [note: 'BK']
  sttp_datang_org varchar [ref: - sttp_dalmat_datangs.no_sttp]
  diminta varchar [ref: > users.kode_user]
  mengetahui varchar [ref: > users.kode_user]
  diterima varchar [ref: > users.kode_user]
  tgl_sttp_datang date
  note: 'tanda tangan penerimaan STTP datang (sttp_dalmat_datang_org)'
}

// ---------- Piece Part ----------

Table piecepart_datangs {
  id uuid [pk]
  id_ppart_datang varchar [note: 'BK']
  sjn_ppart varchar [unique]
  batc varchar
  no_part varchar [ref: > md_headers.part_no]
  no_part2 varchar
  nama_part varchar
  oka varchar [ref: > okas.oka]
  qty_datang varchar
  tgl_datang date
  ket_ppart_datang varchar
  note: 'penerimaan piece part (piecepart_datang)'
}

Table pieceparts {
  id uuid [pk]
  id_piecepart bigint [note: 'BK']
  no_piecepart varchar [unique]
  no_part1 varchar [ref: > piecepart_datangs.no_part]
  no_part2 varchar [ref: > md_headers.part_no]
  proyek1 varchar [ref: > proyeks.kode_proyek]
  oka1 varchar [ref: > okas.oka]
  group1 varchar
  qty_car varchar
  qty_datang1 varchar
  qty_ambil varchar
  qty_total varchar
  ket_piecepart varchar
  note: 'stock piece part'
}

Table ncrs {
  id uuid [pk]
  id_ncr varchar [note: 'BK']
  sjn_ppart varchar [ref: > piecepart_datangs.sjn_ppart]
  no_part varchar [ref: > md_headers.part_no]
  oka varchar [ref: > okas.oka]
  qty_ncr varchar
  tgl_ncr date
  diperbaiki varchar
  buatbaru varchar
  ket_ncr varchar
  note: 'Non-Conformance Report (ncr)'
}

// ---------- MD / Grafik / Jadwal ----------

Table md_gambars {
  id uuid [pk]
  proyek varchar [ref: > proyeks.kode_proyek]
  part_no varchar [ref: > md_headers.part_no]
  gambar varchar
  ada_gbr varchar
  note: 'gambar MD (md_gambar)'
}

Table bobot_parts {
  id uuid [pk]
  oka varchar [ref: > okas.oka]
  proyek varchar [ref: > proyeks.kode_proyek]
  lot varchar
  part_no varchar [ref: > md_headers.part_no]
  bobot decimal
  status varchar
  ket varchar
  note: 'bobot per part/oka/lot (bobot_part)'
}

Table grafik_md {
  id uuid [pk]
  g_proyek varchar [ref: > proyeks.kode_proyek]
  g_nama varchar
  g_lot varchar
  g_md varchar
  g_wi varchar
  g_tampil varchar
  note: 'data grafik monitoring MD'
}

Table jadwals {
  id uuid [pk]
  id_jadwal varchar [note: 'BK']
  oka_jadwal varchar [ref: > okas.oka]
  group_jadwal varchar
  lot varchar
  jadwal_wi date
  jadwal_md2 varchar [ref: > md2s.md2_mdh]
  note: 'jadwal MD (jadwal)'
}

Table mdrs {
  id uuid [pk]
  id_mdr varchar [note: 'BK']
  proyek varchar [ref: > proyeks.kode_proyek]
  oka varchar [ref: > okas.oka]
  tgl_mdr date
  pic varchar [ref: > users.kode_user]
  masalah text
  lanjut text
  input varchar
  dampak varchar
  note: 'Manufacturing Defect Report (mdr)'
}

Table memos {
  id uuid [pk]
  id_memo varchar [note: 'BK']
  part_no varchar [ref: > md_headers.part_no]
  title varchar
  proyek varchar [ref: > proyeks.kode_proyek]
  oka varchar [ref: > okas.oka]
  status_p varchar
  ket varchar
  status_mach varchar
  note: 'memo part/produksi (memo)'
}

Table memo_masuks {
  id uuid [pk]
  nomer_memo varchar [unique]
  bag_pengirim varchar
  perihal varchar
  penerima varchar
  pemroses varchar
  tgl_terima date
  keterangan varchar
  user_memo_masuk varchar [ref: > users.kode_user]
  nama_file varchar
  note: 'memo masuk (memo_masuk)'
}

Table lap_wi {
  id uuid [pk]
  part_no varchar [ref: > md_headers.part_no]
  oka varchar [ref: > okas.oka]
  lot varchar
  proyek varchar [ref: > proyeks.kode_proyek]
  renc_md_trn date
  renc_wi_trn date
  status_peng varchar
  ket_status varchar
  note: 'laporan WI (rencana)'
}

Table self_checks {
  id uuid [pk]
  id_self_check varchar [note: 'BK']
  no_part varchar [ref: > md_headers.part_no]
  nama varchar
  rev varchar
  oka varchar [ref: > okas.oka]
  lot varchar
  qty_lot varchar
  qty varchar
  tgl_kirim date
  note: 'self check part (self_check)'
}

// ---------- Gas ----------

Table gases {
  id uuid [pk]
  no_botol varchar [unique]
  vendor varchar
  no_spp varchar
  kode_gas varchar [ref: > wi_trn_bpms.idbarang]
  tgl_masuk date
  no_bpm varchar [ref: > bpms.no_bpm]
  no_spm varchar [ref: > spms.no_spm]
  tgl_bpm date
  tgl_spm date
  bagian varchar
  tb_isi varchar
  tb_kosong varchar
  tek_awal varchar
  tek_akhir varchar
  no_ambil varchar
  tgl_ambil date
  no_keluar varchar
  tgl_keluar date
  user_gas varchar [ref: > users.kode_user]
  note: 'pengelolaan gas (gas)'
}

// ---------- Consumable / Tool ----------

Table con_fab_ims {
  id uuid [pk]
  nama varchar
  spesifikasi varchar
  kode_alat varchar [unique]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  jumlah varchar
  satuan varchar
  kondisi varchar
  lokasi varchar
  no_rak varchar
  foto varchar
  note: 'consumable fabrikasi IMS'
}

Table con_fin_ims {
  id uuid [pk]
  nama varchar
  spesifikasi varchar
  kode_alat varchar [unique]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  jumlah varchar
  satuan varchar
  kondisi varchar
  lokasi varchar
  no_rak varchar
  foto varchar
  note: 'consumable finishing IMS'
}

Table tool_fabs {
  id uuid [pk]
  nama varchar
  spesifikasi varchar
  kode_alat varchar [unique]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  jumlah varchar
  satuan varchar
  kondisi varchar
  lokasi varchar
  no_rak varchar
  foto varchar
  note: 'tool fabrikasi (tool_fab)'
}

Table tool_fabs_ims {
  id uuid [pk]
  nama varchar
  spesifikasi varchar
  kode_alat varchar [unique]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  jumlah varchar
  satuan varchar
  kondisi varchar
  lokasi varchar
  no_rak varchar
  foto varchar
  user_tool_ims varchar [ref: > users.kode_user]
  note: 'tool fabrikasi IMS (tool_fab_ims)'
}

Table tool_fins {
  id uuid [pk]
  nama varchar
  spesifikasi varchar
  kode_alat varchar [unique]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  jumlah varchar
  satuan varchar
  kondisi varchar
  lokasi varchar
  no_rak varchar
  foto varchar
  note: 'tool finishing (tool_fin)'
}

Table tool_fins_ims {
  id uuid [pk]
  nama varchar
  spesifikasi varchar
  kode_alat varchar [unique]
  kode_mesin varchar [ref: > mesins.kode_mesin]
  jumlah varchar
  satuan varchar
  kondisi varchar
  lokasi varchar
  no_rak varchar
  foto varchar
  user_tool_ims varchar [ref: > users.kode_user]
  note: 'tool finishing IMS (tool_fin_ims)'
}

// ---------- Work Instruction ----------

Table wi_trns {
  id uuid [pk]
  oka varchar [ref: > okas.oka]
  proyek varchar [ref: > proyeks.kode_proyek]
  wbs varchar
  lot varchar
  part_no varchar [ref: > md_headers.part_no]
  partno1 varchar
  qty_lot varchar
  tgl_trn date
  no_ctplan varchar [ref: > cp_details.cp_no]
  tgl_ctplan date
  idbarang varchar [ref: > wi_trn_bpms.idbarang]
  no_bpm varchar [ref: > bpms.no_bpm]
  tgl_bpm date
  barcode varchar [ref: - barcodes.no_konv]
  status varchar
  ket varchar
  jenis_kereta varchar [ref: > jenis_keretas.jenis_kereta]
  no_konv varchar [unique]
  aproved varchar
  aproved1 varchar
  aproved2 varchar
  mat_cp date
  spek_mat_cp date
  planer date
  no_exp varchar [ref: > exps.no_exp]
  qty_cp varchar
  mat_sisa varchar
  ket_wi varchar
  keterangan varchar
  rev varchar
  ket_mat varchar
  status_mat varchar
  no_pr varchar
  no_po varchar
  eta varchar
  id_bpm_cp uuid [ref: > bpm_cps.id]
  qty_car varchar
  tinggi varchar
  tebal varchar
  lebar varchar
  panjang varchar
  name varchar
  user_cp varchar [ref: > users.kode_user]
  user_print varchar [ref: > users.kode_user]
  type varchar
  group_wi varchar
  konv_wi varchar [ref: - wi_trns.no_konv]
  target_wi date
  note_wi varchar
  note: 'tabel utama Work Instruction (transaksi WI, wi_trn)'
}

Table wi_finishes {
  id uuid [pk]
  oka varchar [ref: > okas.oka]
  proyek varchar [ref: > proyeks.kode_proyek]
  lot varchar
  part_no varchar [ref: > wi_trns.part_no]
  qty_fin decimal
  tgl_fin date
  jenis_kereta varchar [ref: > jenis_keretas.jenis_kereta]
  cetak varchar
  no_sttp varchar [ref: > sttpps.nosttpp]
  pengirim varchar [ref: > users.kode_user]
  penerima varchar [ref: > users.kode_user]
  keterangan varchar
  note: 'WI selesai (wi_finish)'
}

// ---------- Tabel Legacy (arsip) ----------

Table user_legacy {
  kode_user varchar [pk]
  nama_user varchar
  username varchar [unique]
  password varchar
  level varchar
  note: 'login aplikasi lama (user)'
}

Table userb_legacy {
  kode_user varchar [pk]
  nama_user varchar
  username varchar [unique]
  password varchar
  level varchar
  note: 'backup user (userb)'
}

Table user_access_legacy {
  Id varchar
  UserName varchar
  Password varchar
  nama varchar
  j_kel varchar
  alamat varchar
  kode_proyek varchar
  oka varchar
  md bigint
  wi bigint
  wi_finish bigint
  sttpp bigint
  st_work bigint
  fab bigint
  painting bigint
  barcode bigint
  utility bigint
  id_kel varchar
  klp_st varchar
  klp_weld varchar
  klp_mch varchar
  klp_int varchar
  klp_wir varchar
  klp_pmk varchar
  klp_pip varchar
  klp_pa varchar
  klp_final varchar
  status varchar
  note: 'RBAC lama / orphan (users lama)'
}